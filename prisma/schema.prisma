generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  TEAM_MEMBER
  TENANT_ADMIN
  CLIENT
  SPECIALIST
  AFFILIATE
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum PlanKind {
  SOFTWARE
  FULL_SERVICE
}

enum SubscriptionStatus {
  UNPAID
  ACTIVE
  INACTIVE
  SUSPENDED
  CANCELLED
}

enum PropertyType {
  RESIDENTIAL_MULTI_TENANT
  COMMERCIAL
  ACTIVE_ADULT_55
  LUXURY_CONDOMINIUM
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum RosterAssignment {
  PRIMARY
  BACKUP
  IN_HOUSE
}

enum ServiceRequestStatus {
  PENDING_REVIEW
  APPROVED
  IN_PROGRESS
  ONGOING
  COMPLETED
  CANCELLED
}

enum ServiceClassification {
  PHYSICAL_COMPLIANCE
  REQUIRES_OPERATIONS_REVIEW
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  RESOLVED_CLOSED
  CANCELLED
}

enum AnswerResult {
  PASS
  FAIL
  NA
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
}

enum ApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model LicensePlan {
  id            String         @id @default(uuid())
  name          String
  kind          PlanKind
  monthlyPrice  Decimal        @db.Decimal(12, 2)
  propertyLimit Int
  active        Boolean        @default(true)
  organizations Organization[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ServicePriceBand {
  id            String         @id @default(uuid())
  kind          PlanKind
  name          String
  minUnits         Int?
  maxUnits         Int?
  maxSquareFootage Int?
  monthlyPrice     Decimal        @db.Decimal(12, 2)
  active        Boolean        @default(true)
  organizations Organization[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model FullServiceMatrixPrice {
  id           String       @id @default(uuid())
  propertyType PropertyType
  tier         Int
  amount       Decimal      @db.Decimal(12, 2)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([propertyType, tier])
}

model SoftwarePlatformPlan {
  id                String   @id @default(uuid())
  tier              Int      @unique
  name              String
  description       String
  monthlyPrice      Decimal  @db.Decimal(12, 2)
  propertyCapacity  Int
  billingFrequency  String   @default("MONTHLY")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AddOnService {
  id           String               @id @default(uuid())
  name         String
  description  String?
  price        Decimal              @db.Decimal(12, 2)
  sortOrder    Int                  @default(0)
  active       Boolean              @default(true)
  requestItems ServiceRequestItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model CompensationTier {
  id           String     @id @default(uuid())
  name         String
  payoutAmount Decimal    @db.Decimal(12, 2)
  active       Boolean    @default(true)
  properties   Property[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Organization {
  id                 String                  @id @default(uuid())
  name               String
  subscriptionStatus   SubscriptionStatus      @default(ACTIVE)
  planKind             PlanKind?
  servicePriceBandId   String?
  servicePriceBand     ServicePriceBand?       @relation(fields: [servicePriceBandId], references: [id])
  stripeCustomerId     String?
  stripeSubscriptionId String?
  paidAt               DateTime?
  licensePlanId        String?
  licensePlan          LicensePlan?            @relation(fields: [licensePlanId], references: [id])
  propertyLimit        Int?
  users              User[]
  properties         Property[]
  serviceRequests    ServiceRequest[]
  checklistAccess    OrganizationChecklist[]
  chat               Chat?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  fullName            String
  phone               String?
  role                UserRole
  status              UserStatus           @default(ACTIVE)
  mustChangePassword  Boolean              @default(false)
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  specialistProfile   SpecialistProfile?
  affiliateProfile    AffiliateProfile?
  passwordResetTokens PasswordResetToken[]
  submittedRequests   ServiceRequest[]     @relation("RequestSubmitter")
  activityEvents      ActivityEvent[]
  chatMessages        ChatMessage[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ChecklistTemplate {
  id                String                  @id @default(uuid())
  name              String
  propertyType      PropertyType?
  active            Boolean                 @default(true)
  items             ChecklistItem[]
  propertyLinks     PropertyChecklist[]
  organizationLinks OrganizationChecklist[]
  inspections       Inspection[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model ChecklistItem {
  id          String             @id @default(uuid())
  templateId  String
  template    ChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category    String
  name        String
  description String?
  sortOrder   Int                @default(0)
  required    Boolean            @default(true)
  answers     InspectionAnswer[]

  @@index([templateId, sortOrder])
}

model OrganizationChecklist {
  organizationId String
  templateId     String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([organizationId, templateId])
}

model Property {
  id                   String                  @id @default(uuid())
  code                 String                  @unique
  organizationId       String
  organization         Organization            @relation(fields: [organizationId], references: [id])
  name                 String
  contactName          String?
  email                String?
  phone                String?
  street               String?
  city                 String?
  state                String?
  zip                  String?
  county               String?
  notes                String?
  propertyType         PropertyType
  status               PropertyStatus          @default(DRAFT)
  unitCount            Int?
  buildingCount        Int?
  squareFootage        Int?
  latitude             Decimal?                @db.Decimal(10, 7)
  longitude            Decimal?                @db.Decimal(10, 7)
  geofenceEnabled      Boolean                 @default(false)
  geofenceRadiusMeters Int                     @default(100)
  timezone             String                  @default("America/New_York")
  photoIdRequired      Boolean                 @default(false)
  checklistsAvailable247 Boolean               @default(false)
  scheduledAt          DateTime?
  compensationTierId   String?
  compensationTier     CompensationTier?       @relation(fields: [compensationTierId], references: [id])
  inspectionDays       PropertyInspectionDay[]
  checklists           PropertyChecklist[]
  roster               PropertyRoster[]
  inspections          Inspection[]
  serviceRequests      ServiceRequest[]
  accessKey            PropertyAccess?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([organizationId])
  @@index([status])
}

model PropertyAccess {
  id                    String   @id @default(uuid())
  propertyId            String   @unique
  property              Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mainEntryInstructions String?
  buildingAccessCode    String?
  elevatorAccess        String?
  lockboxCode           String?
  emergencyContactName  String?
  emergencyContactTitle String?
  emergencyContactPhone String?
  additionalNotes       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PropertyInspectionDay {
  propertyId String
  weekday    Weekday
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, weekday])
}

model PropertyChecklist {
  propertyId String
  templateId String
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([propertyId, templateId])
}

model PropertyRoster {
  id           String            @id @default(uuid())
  propertyId   String
  specialistId String
  assignment   RosterAssignment
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  specialist   SpecialistProfile @relation(fields: [specialistId], references: [id])

  @@unique([propertyId, specialistId])
}

model ServiceRequest {
  id             String                @id @default(uuid())
  code           String                @unique
  organizationId String?
  organization   Organization?         @relation(fields: [organizationId], references: [id])
  propertyId     String?
  property       Property?             @relation(fields: [propertyId], references: [id])
  submittedById  String?
  submittedBy    User?                 @relation("RequestSubmitter", fields: [submittedById], references: [id])
  kind           PlanKind?
  propertyType   PropertyType
  unitCount      Int?
  buildingCount  Int?
  squareFootage  Int?
  street         String?
  city           String?
  state          String?
  zip            String?
  contactName    String
  companyName    String
  email          String
  phone          String?
  notes                   String?
  stripeCheckoutSessionId String?               @unique
  status                  ServiceRequestStatus  @default(PENDING_REVIEW)
  classification ServiceClassification?
  items          ServiceRequestItem[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, createdAt])
}

model ServiceRequestItem {
  serviceRequestId String
  addOnServiceId   String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  addOnService     AddOnService   @relation(fields: [addOnServiceId], references: [id])

  @@id([serviceRequestId, addOnServiceId])
}

model SpecialistProfile {
  id                        String            @id @default(uuid())
  userId                    String            @unique
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  code                      String            @unique
  applicationStatus         ApplicationStatus @default(SUBMITTED)
  street                    String?
  city                      String?
  state                     String?
  zip                       String?
  travelRadiusMiles         Int?
  shiftPreference           String?
  yearsExperience           Int?
  propertyTypesExperience   String?
  experienceSummary         String?
  regulationSummary         String?
  comfortRating             Int?
  situationalAnswers        Json?
  hasTransportation         Boolean?
  canDoMultiPointInspection Boolean?
  hasUniformAndRadio        Boolean?
  backgroundCheckConsent    Boolean           @default(false)
  roster                    PropertyRoster[]
  inspections               Inspection[]
  payouts                   Payout[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
}

model AffiliateProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName       String
  jobTitle          String?
  website           String?
  businessType      String?
  marketSummary     String?
  portfolioBand     String?
  strategyAnswers   Json?
  termsAccepted     Boolean           @default(false)
  taxAcknowledged   Boolean           @default(false)
  applicationStatus ApplicationStatus @default(SUBMITTED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Inspection {
  id           String             @id @default(uuid())
  propertyId   String
  property     Property           @relation(fields: [propertyId], references: [id])
  templateId   String
  template     ChecklistTemplate  @relation(fields: [templateId], references: [id])
  specialistId String?
  specialist   SpecialistProfile? @relation(fields: [specialistId], references: [id])
  scheduledAt  DateTime
  status       InspectionStatus   @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  answers      InspectionAnswer[]
  report       Report?
  payout       Payout?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([propertyId, scheduledAt])
  @@index([status])
}

model InspectionAnswer {
  id              String        @id @default(uuid())
  inspectionId    String
  checklistItemId String
  inspection      Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id])
  result          AnswerResult?
  note            String?
  photoUrl        String?
  latitude        Decimal?      @db.Decimal(10, 7)
  longitude       Decimal?      @db.Decimal(10, 7)
  capturedAt      DateTime?

  @@unique([inspectionId, checklistItemId])
}

model Report {
  id           String     @id @default(uuid())
  inspectionId String     @unique
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  summary      String?
  pdfUrl       String?
  emailedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Payout {
  id           String            @id @default(uuid())
  specialistId String
  specialist   SpecialistProfile @relation(fields: [specialistId], references: [id])
  inspectionId String?           @unique
  inspection   Inspection?       @relation(fields: [inspectionId], references: [id])
  amount       Decimal           @db.Decimal(12, 2)
  status       PayoutStatus      @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([specialistId, status])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}

model Chat {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ChatMessage {
  id        String   @id @default(uuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

model ActivityEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  type       String
  summary    String
  entityType String
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
